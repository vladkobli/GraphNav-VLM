<?xml version="1.0"?>
<robot name="panther_sensors_only" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Sensor-only URDF for the physical Panther.

    Do NOT include the full Husarion Panther URDF here.
    The physical robot already publishes:
      /panther/robot_description
      /panther/joint_states
      panther/base_footprint -> panther/base_link -> ...
  -->

  <!-- Existing frame from the physical Panther TF tree.
       This is only declared as the root link for this small sensor URDF.
       robot_state_publisher will not publish a transform for the root itself. -->
  <link name="panther/base_footprint"/>

  <!-- ========================================================= -->
  <!-- Velodyne VLP-16                                          -->
  <!-- Desired TF:                                               -->
  <!-- panther/base_footprint -> panther/velodyne_link            -->
  <!-- xyz = 0.125 0.02 0.825                                    -->
  <!-- ========================================================= -->

  <joint name="velodyne_joint" type="fixed">
    <parent link="panther/base_footprint"/>
    <child link="panther/velodyne_link"/>
    <origin xyz="0.125 0.02 0.825" rpy="0 0 0"/>
  </joint>

  <link name="panther/velodyne_link">
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.052" length="0.07"/>
      </geometry>
      <material name="velodyne_black">
        <color rgba="0.02 0.02 0.02 1.0"/>
      </material>
    </visual>
  </link>

</robot>
