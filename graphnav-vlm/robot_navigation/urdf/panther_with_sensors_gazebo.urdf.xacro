<?xml version="1.0"?>
<robot name="panther_with_sensors" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include the original Husarion Panther description -->
  <xacro:include filename="$(find husarion_ugv_description)/urdf/panther.urdf.xacro"/>

  <!-- ========================================================= -->
  <!-- Velodyne VLP-16 mount                                     -->
  <!-- Equivalent static TF:                                     -->
  <!-- 0.125 0.02 0.825 0 0 0 base_footprint velodyne_link       -->
  <!-- 0.125 0.02 0.643 0 0 0 base_link velodyne_link            -->
  <!-- ========================================================= -->

  <link name="velodyne_link">
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.052" length="0.07"/>
      </geometry>
      <material name="velodyne_black">
        <color rgba="0.02 0.02 0.02 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.052" length="0.07"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <mass value="0.83"/>
      <inertia
        ixx="0.001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.001"
        iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="velodyne_joint" type="fixed">
    <parent link="base_link"/>
    <child link="velodyne_link"/>
    <origin xyz="0.125 0.02 0.643" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Classic VLP-16-like point cloud sensor -->
  <gazebo reference="velodyne_link">
    <sensor name="velodyne_vlp16" type="gpu_ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>

      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265359</min_angle>
            <max_angle>3.14159265359</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>

        <range>
          <min>0.2</min>
          <max>100.0</max>
          <resolution>0.01</resolution>
        </range>

        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>

      <plugin name="velodyne_ros_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/velodyne_points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>velodyne_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ========================================================= -->
  <!-- RealSense-like camera mount                               -->
  <!-- Equivalent static TF:                                     -->
  <!-- 0.125 0.02 0.643 0 0 0 base_footprint camera_link         -->
  <!-- 0.125 0.02 0.643 0 0 0 base_link velodyne_link            -->
  <!-- ========================================================= -->

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.01 0.01 0.01 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.125 -0.15 0.643" rpy="0 0 0"/>
  </joint>

  <!-- ROS optical frame convention -->
  <link name="camera_depth_optical_frame"/>

  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="camera_color_optical_frame"/>

  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <!-- Gazebo RGB camera -->
  <gazebo reference="camera_link">
    <sensor name="realsense_rgb" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>

      <camera>
        <horizontal_fov>1.211</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
      </camera>

      <plugin name="realsense_rgb_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera/color</namespace>
          <remapping>image_raw:=image_raw</remapping>
          <remapping>camera_info:=camera_info</remapping>
        </ros>
        <camera_name>color</camera_name>
        <frame_name>camera_color_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Gazebo depth camera -->
  <gazebo reference="camera_link">
    <sensor name="realsense_depth" type="depth">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>

      <camera>
        <horizontal_fov>1.211</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>

      <plugin name="realsense_depth_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera/depth</namespace>
          <remapping>image_raw:=image_raw</remapping>
          <remapping>camera_info:=camera_info</remapping>
        </ros>
        <camera_name>depth</camera_name>
        <frame_name>camera_depth_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
